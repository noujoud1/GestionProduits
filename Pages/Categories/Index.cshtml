@page
@model GestionProduits.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Catégories";
}

<h1>Catégories</h1>

<a asp-page="Create" class="btn btn-success mb-3">Nouvelle catégorie</a>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.Nom</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Modifier</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>